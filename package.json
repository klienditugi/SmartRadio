{
  "name": "subwave-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Sub Wave AI Radio Automation — backend foundation",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.typecheck.json --pretty",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "pnpm --filter @subwave-ai/api dev",
    "dev:worker": "pnpm --filter @subwave-ai/worker dev",
    "openapi": "pnpm --filter @subwave-ai/api openapi",
    "clean": "rm -rf apps/*/dist packages/*/dist *.tsbuildinfo apps/*/*.tsbuildinfo packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
