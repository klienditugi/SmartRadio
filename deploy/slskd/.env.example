# slskd secrets and host paths for deploy/slskd/docker-compose.yml.
# install-slskd.sh copies this to .env (mode 600). Never commit .env.
# Soulseek username, password, and API key stay empty in this example.
# They are slskd secrets only. Do not copy them into SmartRadio.

# Official image. Manifest includes linux/amd64 and linux/arm64.
# Alternate registry: ghcr.io/slskd/slskd:latest
SLSKD_IMAGE=slskd/slskd:latest

# Numeric uid:gid for Docker user:. install-slskd.sh fills these from
# `id -u` / `id -g` when they are empty. Do not set PUID or PGID as well.
SLSKD_UID=
SLSKD_GID=

# 0022: owner write, not world-writable. Do not set 0000.
SLSKD_UMASK=0022

# Host directories. Relative paths are relative to deploy/slskd/.
# Completed downloads must be the same directory SmartRadio uses as
# paths.downloads (SUBWAVE_DOWNLOADS_DIR).
# First-host example (comment only, not a default):
# SLSKD_DOWNLOADS_DIR=/music/downloads
# SmartRadio library example (never a volume here):
# /music/library
SLSKD_APP_DIR=./state
SLSKD_DOWNLOADS_DIR=./downloads
SLSKD_INCOMPLETE_DIR=./incomplete

# Host ports to verify after start: API 5030, optional HTTPS 5031, listen 50300.
SLSKD_HTTP_PORT=5030
SLSKD_HTTPS_PORT=5031
SLSKD_LISTEN_PORT=50300
# API and optional HTTPS bind. Listen stays open so peers can connect.
SLSKD_HTTP_BIND=127.0.0.1
SLSKD_LISTEN_BIND=0.0.0.0

# slskd secrets. Empty placeholders. No real credentials.
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=
SLSKD_API_KEY=
