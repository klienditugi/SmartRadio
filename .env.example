# Copy to `.env` in the local clone directory named `subwave-ai`. Never commit real values.
# All live URLs/credentials stay here or in `secrets/` — not in source.
# Do not leave production IPs, hosts, ports, or model names as filled defaults.

SUBWAVE_CONFIG=./config/subwave.yaml
SUBWAVE_SECRETS_DIR=./secrets
SUBWAVE_DATA_DIR=./data
SUBWAVE_CONFIG_DIR=./config

# API bind — default is loopback. Do not reuse a generic PORT/HOST env var.
SUBWAVE_API_HOST=127.0.0.1
SUBWAVE_API_PORT=8788

SUBWAVE_DB_PATH=./data/subwave.sqlite
# Local-dev placeholders. Live Oracle examples (not required defaults):
# SUBWAVE_DOWNLOADS_DIR=/music/downloads
# SUBWAVE_LIBRARY_DIR=/music/library
SUBWAVE_DOWNLOADS_DIR=./data/downloads
SUBWAVE_STAGING_DIR=./data/staging
SUBWAVE_LIBRARY_DIR=./data/library

SUBWAVE_ADMIN_USERNAME=admin

# Built UI served by the API. Uncomment after `pnpm --filter @subwave-ai/web build`.
# SUBWAVE_WEB_DIST=./apps/web/dist
# SUBWAVE_WEB_ORIGIN=

# Ollama is EXTERNAL. Do not install, pull, or update models from this app.
# Set both to your existing daemon — there is no default model name.
# Live example (not a default): OLLAMA_BASE_URL=http://100.119.17.28:11434 (v0.34.0).
# Do not hard-code qwen3:8b even if that tag exists on the daemon.
# llm.verify_status, library.verify_status, and radio.verify_status default to unverified.
# These env vars do not mark an integration verified. Set verify_status: verified in yaml
# only after an explicit successful verification.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

NAVIDROME_URL=
NAVIDROME_USER=

# Opaque SUB/WAVE base URL (live example already includes `/api`):
# SUBWAVE_RADIO_URL=http://127.0.0.1:7700/api
# Documented GETs: /health → {"status":"on-air"}, /state, /now-playing.
# Notify for REQUEST_ACCEPTED / TRACK_READY = SERVER INSPECTION REQUIRED.
# radio.verify_status defaults to unverified. This URL does not set it.
SUBWAVE_RADIO_URL=
SUBWAVE_RADIO_ADMIN_USER=

# No acquisition daemon on Oracle today. Leave empty / unverified until a
# verified slskd exists. Doctor surfaces acquire_unavailable.
SLSKD_URL=
# Optional overrides for acquisition.selection (yaml is the default).
# Size is mebibytes (1024*1024). Duration is seconds; leave unset for no limit.
# Sample rate is Hz and bit depth is bits. Defaults are broadcast-friendly: 48000 and 24.
# Files that report a higher value are excluded. Files that omit the fields stay eligible.
# SLSKD_MAX_FILE_SIZE_MB=200
# SLSKD_MIN_FILE_SIZE_MB=1
# SLSKD_MAX_DURATION_SECONDS=
# SLSKD_MAX_SAMPLE_RATE=48000
# SLSKD_MAX_BIT_DEPTH=24
