# Copy to `.env` in the local clone directory named `subwave-ai`. Never commit real values.
# All live URLs/credentials stay here or in `secrets/` — not in source.
# Do not leave production IPs, hosts, ports, or model names as filled defaults.

SUBWAVE_CONFIG=./config/subwave.yaml
SUBWAVE_SECRETS_DIR=./secrets
SUBWAVE_DATA_DIR=./data
SUBWAVE_CONFIG_DIR=./config

# API bind — default is loopback. Do not reuse a generic PORT/HOST env var.
SUBWAVE_API_HOST=127.0.0.1
SUBWAVE_API_PORT=8788

SUBWAVE_DB_PATH=./data/subwave.sqlite
SUBWAVE_DOWNLOADS_DIR=./data/downloads
SUBWAVE_STAGING_DIR=./data/staging
SUBWAVE_LIBRARY_DIR=./data/library

SUBWAVE_ADMIN_USERNAME=admin

# Built UI served by the API. Uncomment after `pnpm --filter @subwave-ai/web build`.
# SUBWAVE_WEB_DIST=./apps/web/dist
# SUBWAVE_WEB_ORIGIN=

# Ollama is EXTERNAL. Do not install, pull, or update models from this app.
# Set both to your existing daemon — there is no default model name.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

NAVIDROME_URL=
NAVIDROME_USER=

# Opaque SUB/WAVE base URL (production may already include `/api`).
SUBWAVE_RADIO_URL=
SUBWAVE_RADIO_ADMIN_USER=

SLSKD_URL=
